# --- Supabase (self-hosted). For local dev: `supabase status -o env` ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- TypeDB 3.x HTTP API (ontology) ---
TYPEDB_URL=http://127.0.0.1:8000
TYPEDB_USERNAME=admin
TYPEDB_PASSWORD=password
TYPEDB_DATABASE=fuku

# --- LLM (optional, any OpenAI-compatible endpoint: OpenAI, OpenRouter, Ollama, LM Studio, vLLM…) ---
# Leave LLM_BASE_URL empty to use Fuku's built-in rule-based brain (works offline).
# Examples:
#   LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4.1-mini
#   LLM_BASE_URL=http://127.0.0.1:11434/v1        LLM_MODEL=qwen2.5:7b      (Ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
